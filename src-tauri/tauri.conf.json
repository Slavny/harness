{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harness-ai-app",
  "version": "0.1.0",
  "identifier": "com.mynam.harness-ai-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XAPHECC",
        "decorations": false,
        "width": 800,
        "height": 600,
        "maximized": true,
        "backgroundColor": "#121212",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
